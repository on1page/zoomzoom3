+
+/** Le stesse città in ordine alfabetico (Bari, Bologna, Cagliari, Catania, …). */
+export const ZOOM_CITIES_ALPHA: ZoomCity[] = [...ZOOM_CITIES].sort((a, b) =>
+  a.name.localeCompare(b.name, "it")
