  themeVariables:
    primaryColor: "#EFF6FF"
    primaryBorderColor: "#3B82F6"
    primaryTextColor: "#1E293B"
    lineColor: "#94A3B8"
    fontSize: "14px"
    fontFamily: "Helvetica, Arial, DejaVu Sans, sans-serif"
  flowchart:
    curve: basis
    padding: 20
    nodeSpacing: 55
